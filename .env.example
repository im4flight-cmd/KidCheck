# Pushpay ChMS (Church Community Builder) API v1 credentials.
# Generate these in ChMS under Settings > API Admin.
# These stay server side on Vercel and never reach the iPad.
CCB_SUBDOMAIN=yourchurch
CCB_API_USER=your-api-username
CCB_API_PASS=your-api-password

# Church timezone, used to work out "today" for the check-in occurrence.
# Schertz, Texas is Central time.
CHURCH_TIMEZONE=America/Chicago

# Optional. Set to "true" to show full last names instead of "Ben B.".
SHOW_FULL_NAMES=false

# How much parent contact to show on each child's card:
#   full = parent name and phone (default), name = parent name only, off = none.
# The phone comes from CCB, so the API user must ALSO have the
# "individual_profile_from_id" service enabled. Consider "name" or "off" if the screen
# is where people who should not see parents' phone numbers could read it.
PARENT_CONTACT_MODE=full

# Optional. The classroom list, as JSON, if you would rather manage rooms in
# Vercel than edit rooms.json. Example:
# ROOMS=[{"id":"12345","name":"Nursery"},{"id":"12346","name":"Preschool"}]
# ROOMS=
